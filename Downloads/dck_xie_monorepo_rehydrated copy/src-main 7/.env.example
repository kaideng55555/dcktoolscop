# DCK Tools - Frontend Environment Variables
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to the repository

# =============================================================================
# SOLANA CONFIGURATION
# =============================================================================

# Solana RPC URL (required)
# Options:
#   - Public: https://api.mainnet-beta.solana.com
#   - QuickNode: https://your-endpoint.quiknode.pro/...
#   - Alchemy: https://solana-mainnet.g.alchemy.com/v2/...
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# EVM RPC URL (optional - for custom EVM provider)
# Options:
#   - Infura: https://mainnet.infura.io/v3/YOUR_PROJECT_ID
#   - Alchemy: https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
VITE_EVM_RPC_URL=

# =============================================================================
# API ENDPOINTS
# =============================================================================

# Backend API URL (optional - defaults to localhost in development)
# Production: Set to your deployed backend URL
# Development: http://localhost:8000
VITE_API_URL=http://localhost:8000

# WebSocket URL (optional - defaults to localhost in development)
# Production: Set to your deployed backend WebSocket URL
# Development: ws://localhost:8000
VITE_WS_URL=ws://localhost:8000

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Solana Network
# Options: mainnet-beta, devnet, testnet
VITE_NETWORK=mainnet-beta

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable developer tools and debugging features
# Set to true for development, false for production
VITE_ENABLE_DEVTOOLS=false

# =============================================================================
# NOTES
# =============================================================================
# - Backend must be running on port 8000 (or update VITE_API_URL)
# - See ENV_CONFIG.md for complete documentation
# - For production deployment, use environment-specific files
# - Never commit files containing API keys or sensitive data
