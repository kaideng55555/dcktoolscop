# Solana RPC Configuration
# Copy this file to .env and add your custom RPC URL

# Default: https://api.mainnet-beta.solana.com
# For better performance, use a custom RPC provider:
# - QuickNode: https://quicknode.com
# - Alchemy: https://alchemy.com
# - Helius: https://helius.dev
# - GenesysGo: https://genesysgo.com

VITE_RPC_URL=https://api.mainnet-beta.solana.com

# Token Configuration
# Your token mint address
VITE_TOKEN_MINT=FaciyzhG9zvki2uRxUfrhghGnv2aFBHibsSnRHoeqd9y

# Treasury wallet address for fee collection
VITE_TREASURY=6MmJ9bAR2nrZQB3kdForaNirMuupPXpovJB3X8jzK29K

# Refresh interval in milliseconds (15 seconds)
VITE_REFRESH_MS=15000
